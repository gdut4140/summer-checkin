# ============================================================
# Summer Checkin — 生产环境变量模板
# 复制为 .env 并填入真实值，不要将 .env 提交到 git！
# ============================================================

# ------------------------------------------------------------
# 数据库 (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/summer_checkin

# ------------------------------------------------------------
# 模型池（src/lib/model-pool.ts）
# 分档：LOW=聊天室/标题/记忆/拆任务（agnes 优先）；HIGH=agent/文档/后台（最强优先，agnes 兜底）
# 阿里云百炼：每个模型独立 100 万 token 免费额度（仅华北2北京生效），
# 额度耗尽返回 403 AllocationQuota.FreeTierOnly，模型池会自动降级到下一个模型。
# 注意：model 必须传完整快照字符串（如 qwen3.8-max），禁止简写。
# ------------------------------------------------------------

# Agnes AI（免费，LOW 档首位 / HIGH 档最后兜底）
# 不设则回退到 DASHSCOPE_*（保持旧配置兼容）
AGNES_API_KEY=sk-your-api-key
AGNES_BASE_URL=https://api.agnes-ai.cn/v1

# 阿里云百炼 key（主池，免费额度）
# 不设则复用 EMBEDDING_API_KEY（即下面的阿里百炼 key）
ALIYUN_API_KEY=sk-your-api-key

# ---- 以下为向后兼容的旧变量（模型池会读取） ----
DASHSCOPE_API_KEY=sk-your-api-key
DASHSCOPE_MODEL=agnes-2.5-flash
DASHSCOPE_BASE_URL=https://api.agnes-ai.cn/v1

# ------------------------------------------------------------
# 用户每日 AI token 限额（雨宝精力；0 = 不限，每日零点重置）
# ------------------------------------------------------------
AI_TOKEN_LIMIT=100000

# ------------------------------------------------------------
# Embedding 向量模型
#
# ⚠️ 模型不在这里配。由 src/lib/model-pool.ts 的 EMBEDDING_CHAIN 硬编码决定：
#    text-embedding-v4 优先 → text-embedding-v3 兜底，两者都是 1024 维。
#
#    链上任何模型的输出维度必须与 embedding 列的 vector(1024) 一致。
#    text-embedding-v2 / v1 是 1536 维，且 v2【直接忽略 dimensions 参数】，
#    物理上做不到 1024——绝不能放进这条链，否则写入会整批失败。
#
#    实际只读取 EMBEDDING_API_KEY 一个变量（作为 ALIYUN_API_KEY 的兜底）。
#    曾有的 EMBEDDING_MODEL / EMBEDDING_BASE_URL 已移除：代码从未读取它们，
#    留着只会让人误以为模型可配。
# ------------------------------------------------------------
EMBEDDING_API_KEY=sk-your-api-key

# ------------------------------------------------------------
# Better Auth（用 openssl rand -base64 32 生成）
# ------------------------------------------------------------
BETTER_AUTH_SECRET=请生成一个64位随机字符串
BETTER_AUTH_URL=http://你的ECS公网IP:3000

# ------------------------------------------------------------
# Next.js Server Actions 加密密钥（用 openssl rand -hex 32 生成）
# 即使单实例部署也建议设置，方便后续扩展
# ------------------------------------------------------------
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=请生成一个64位随机hex字符串

# ------------------------------------------------------------
# OSS 对象存储（头像/壁纸「预签名 PUT 直传」）
# 浏览器直传 OSS，服务器不承接文件流量；AccessKey 仅存服务端
# ------------------------------------------------------------
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
OSS_BUCKET=summer-checkin-app
OSS_REGION=oss-cn-guangzhou
OSS_PUBLIC_BASE_URL=https://summer-checkin-app.oss-cn-guangzhou.aliyuncs.com
