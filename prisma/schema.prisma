generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  password      String?
  bio           String?
  theme         String    @default("system")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions     Session[]
  accounts     Account[]
  plans        Plan[]
  checkins     Checkin[]
  studyRecords StudyRecord[]
  userBadges   UserBadge[]
  aiHistories   AIHistory[]
  memories      UserMemory[]
  conversations Conversation[]
  planTasks     PlanTask[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id           String   @id @default(cuid())
  userId       String
  providerId   String
  accountId    String
  provider     String   @default("credential")
  password     String?
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Plan {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  goal        String?
  targetHours Float     @default(0)
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins Checkin[]
  tasks    PlanTask[]
}

// ============================================================
// Day 22 Agent Workflow: 计划任务拆分
// 每个 Plan 可拆分为多个 Task（按天/周组织）
// ============================================================
model PlanTask {
  id          String    @id @default(cuid())
  planId      String
  userId      String
  title       String                                    // 任务标题
  description String?    @db.Text                       // 任务详细描述
  dayNumber   Int?                                      // 第几天（如 Day 1, Day 2...）
  weekNumber  Int?                                      // 第几周
  category    String     @default("study")              // study | project | review | exercise
  status      String     @default("pending")            // pending | in_progress | done | skipped
  priority    String     @default("normal")             // high | normal | low
  completedAt DateTime?                                 // 完成时间
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([userId, status])
  @@index([userId, dayNumber])
}

model Checkin {
  id          String   @id @default(cuid())
  userId      String
  planId      String?
  content     String
  hours       Float    @default(0)
  subject     String?
  mood        String?
  screenshot  String?
  checkinDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id])

  @@index([userId, checkinDate])
}

model StudyRecord {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  totalMinutes Float    @default(0)
  subject      String?
  checkinId    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  criteria    String
  createdAt   DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([userId, updatedAt])
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "assistant"
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  category  String   @default("fact") // preference | goal | skill | fact
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AIHistory {
  id        String   @id @default(cuid())
  userId    String
  message   String   @db.Text
  response  String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================================
// Day 16 RAG: 文档分块 + 向量存储
// embedding 用 MySQL JSON 存储（数据量 < 1000 时可行）
// 检索和重排在 src/lib/rag/ 中
// ============================================================
model DocumentChunk {
  id         String   @id @default(cuid())
  sourceName String   // 来源文件名
  sourceType String   @default("text") // pdf | markdown | text | conversation
  chunkIndex Int      // 分片序号，从 0 开始
  content    String   @db.Text
  embedding  Json     // bge-small-zh-v1.5 512 维向量，存为 JSON 数组
  createdAt  DateTime @default(now())

  @@index([sourceName])
}
