generator client {
  provider = "prisma-client"
  // 生成物刻意**不放 src/**：每次 prisma generate 都会重写这一整目录（30+ 文件），
  // 放在源码树里会让 dev server 的模块图整片失效、把所有页面重新编译一遍，
  // 也把 src/ 搅得不像源码。prisma/ 下与 schema、手工 SQL 迁移脚本同处一处更好找。
  // 引用方式：src/ 内用 "@/prisma-generated/client"（见 tsconfig paths），
  // scripts/ 与 prisma/seed.ts 用相对路径。
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  password      String?
  bio           String?
  theme         String   @default("system")
  /// VIP：不受每日 AI token 限额约束（用量仍照常记账）。
  /// 这不是安全边界——它只影响 usage.ts 的限额判断，不改变任何鉴权。
  vip           Boolean  @default(false)
  /// 上次被弹「每日公告」的日期，格式 YYYY-MM-DD，由客户端按**自己的本地时区**写入。
  /// 放服务端是为了跨设备 / 跨标签页去重；服务端不解释这个值，只做字符串相等比较。
  announcementSeenOn String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  plans         Plan[]
  checkins      Checkin[]
  studyRecords  StudyRecord[]
  memories      UserMemory[]
  conversations Conversation[]
  planTasks     PlanTask[]
  agentRuns     AgentRun[]
  notifications Notification[]
  todos           Todo[]
  docs            Document[]
  documents       DocumentChunk[]
  knowledgeDocs   KnowledgeDoc[]
  chatMessages    ChatMessage[]
  tokenUsages     TokenUsage[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id           String   @id @default(cuid())
  userId       String
  providerId   String
  accountId    String
  provider     String   @default("credential")
  password     String?
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Plan {
  id              String    @id @default(cuid())
  userId          String
  name            String
  description     String?
  goal            String?
  document        String?
  // 任务最后一次拆分时所用文档的哈希，用于判断文档改动后任务是否过期（抽屉手动刷新）
  tasksSourceHash String?
  // 任务正在后台拆分的起始时间（非空 = 刷新中），供抽屉显示"任务刷新中"
  tasksSplittingAt DateTime?
  startDate       DateTime?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins Checkin[]
  tasks    PlanTask[]

  @@map("plan")
}

model PlanTask {
  id          String    @id @default(cuid())
  planId      String
  userId      String
  title       String
  description String?
  dayNumber   Int?
  weekNumber  Int?
  category    String    @default("study")
  status      String    @default("pending")
  priority    String    @default("normal")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([userId, status])
  @@index([userId, dayNumber])
  @@map("plantask")
}

model Todo {
  id        String   @id @default(cuid())
  userId    String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@index([userId, createdAt])
  @@map("todo")
}

model Checkin {
  id           String   @id @default(cuid())
  userId       String
  planId       String?
  sourceTaskId String?
  content      String
  hours        Float    @default(0)
  subject      String?
  mood         String?
  screenshot   String?
  checkinDate  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id])

  @@index([userId, checkinDate])
  @@index([sourceTaskId])
  @@map("checkin")
}

model StudyRecord {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  totalMinutes Float    @default(0)
  subject      String?
  checkinId    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("studyrecord")
}

model AvatarChange {
  id        String   @id @default(cuid())
  userId    String
  image     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("avatarchange")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  /**
   * 界面来源，三选一：agent 智能体页 / doc 文档工作台 / plan 计划工作台。
   * 三者共用这一张表，靠 surface + refId 才能严格区分。
   *
   * 注意：与 tokenusage.surface 是**两套不同的口径**，不要强行对齐——
   * 那边是记账用的（agent | studio | chatroom | title | memory | split | agent-bg），
   * 历史数据已按旧口径落库，且把文档与计划合并为 studio 即可满足统计需要；
   * 这里要区分到「哪篇文档/计划」，粒度更细。
   */
  surface   String   @default("agent")
  /**
   * 归属对象：surface=doc 时为文档 id，surface=plan 时为计划 id，agent 时为 null。
   *
   * 有了这一列，工作台才能直接问服务端「这篇文档/计划的对话是哪一条」——
   * 在此之前这个绑定只存在浏览器 localStorage 里（studio-chat:doc:<id>），
   * 换设备 / 清缓存就断，点「新对话」更会把上一条变成谁也够不着的孤儿。
   * 历史上（2026-09 之前）创建的对话没有这一列的值，无法追溯归属，只能为 null。
   */
  refId     String?
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([userId, updatedAt])
  // 对话的访问路径：userId + surface(+refId) 过滤后按 updatedAt 倒序
  @@index([userId, surface, refId, updatedAt])
  @@map("conversation")
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversationmessage")
}

model AgentRun {
  id          String    @id @default(cuid())
  userId      String
  mode        String    @default("planner")
  goal        String
  status      String    @default("queued")
  currentStep Int       @default(0)
  maxSteps    Int       @default(12)
  summary     String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps     AgentStep[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@map("agentrun")
}

model AgentStep {
  id          String    @id @default(cuid())
  runId       String
  stepNumber  Int
  kind        String
  status      String    @default("pending")
  title       String
  detail      String?
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  run       AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, stepNumber])
  @@index([runId, status])
  @@map("agentstep")
}

model UserMemory {
  id         String                      @id @default(cuid())
  userId     String
  type       String                      @default("fact")
  content    String
  embedding  Unsupported("vector(1024)")?
  importance Float                       @default(0.5)
  confidence Float                       @default(0.5)
  lastUsed   DateTime?
  createdAt  DateTime                    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, importance])
  @@index([userId, lastUsed])
  @@map("usermemory")
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("document")
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  userId     String
  sourceName String
  sourceType String                      @default("text")
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1024)")
  createdAt  DateTime                    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sourceName])
  @@index([sourceName])
  @@map("documentchunk")
}

model KnowledgeDoc {
  id         String   @id @default(cuid())
  userId     String
  sourceName String
  sourceType String
  content    String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceName])
  @@index([userId])
  @@map("knowledgedoc")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("reminder")
  title     String
  content   String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, type])
  @@map("notification")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String?
  role      String   @default("user")
  content   String
  /** 聊天室 AI 角色（温柔宝/嘴欠宝）；AI 消息用于区分，让上下文标注不串风格 */
  aiRole    String?
  /** 引用回复：被引用的消息 id（无 = 普通消息） */
  replyToId String?
  createdAt DateTime @default(now())

  user    User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  replyTo ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies ChatMessage[] @relation("ChatReply")

  @@index([createdAt])
  @@index([replyToId])
  @@map("chatmessage")
}

// ── 新用户引导模板（注册时克隆给新用户） ──
model PlanTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  goal        String?
  document    String? // Markdown，含「## 任务安排」段落；克隆后 syncTasksFromDocument 生成任务
  createdAt   DateTime @default(now())

  @@map("plantemplate")
}

model DocumentTemplate {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())

  @@map("documenttemplate")
}

// ── 用户 AI token 用量（每日限额；模型池统一记账） ──
model TokenUsage {
  id           String   @id @default(cuid())
  userId       String
  surface      String // agent | studio | chatroom | title | memory | split | agent-bg
  tier         String // low | high
  model        String // 实际使用模型
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("tokenusage")
}

/// 全站公告 —— 不按用户存，一份所有人看同一份
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String // Markdown
  /// 是否对用户可见。发错了改成 false 即可撤下，不必删数据
  published Boolean  @default(true)
  /// 是否参与「每天首次进入弹一次」。false 则只出现在铃铛的公告列表里
  popup     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@map("announcement")
}
