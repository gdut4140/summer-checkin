generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  password      String?
  bio           String?
  theme         String   @default("system")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  plans         Plan[]
  checkins      Checkin[]
  studyRecords  StudyRecord[]
  userBadges    UserBadge[]
  aiHistories   AIHistory[]
  memories      UserMemory[]
  conversations Conversation[]
  planTasks     PlanTask[]
  agentRuns     AgentRun[]
  decisions     AgentDecision[]
  notifications Notification[]
  schedules       AgentSchedule[]
  todos           Todo[]
  documents       DocumentChunk[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id           String   @id @default(cuid())
  userId       String
  providerId   String
  accountId    String
  provider     String   @default("credential")
  password     String?
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Plan {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  goal        String?
  targetHours Float     @default(0)
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins Checkin[]
  tasks    PlanTask[]

  @@map("plan")
}

model PlanTask {
  id          String    @id @default(cuid())
  planId      String
  userId      String
  title       String
  description String?
  dayNumber   Int?
  weekNumber  Int?
  category    String    @default("study")
  status      String    @default("pending")
  priority    String    @default("normal")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([userId, status])
  @@index([userId, dayNumber])
  @@map("plantask")
}

model Todo {
  id        String   @id @default(cuid())
  userId    String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@index([userId, createdAt])
  @@map("todo")
}

model Checkin {
  id           String   @id @default(cuid())
  userId       String
  planId       String?
  sourceTaskId String?
  content      String
  hours        Float    @default(0)
  subject      String?
  mood         String?
  screenshot   String?
  checkinDate  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id])

  @@index([userId, checkinDate])
  @@index([sourceTaskId])
  @@map("checkin")
}

model StudyRecord {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  totalMinutes Float    @default(0)
  subject      String?
  checkinId    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("studyrecord")
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  criteria    String
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@map("badge")
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("userbadge")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([userId, updatedAt])
  @@map("conversation")
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversationmessage")
}

model AgentRun {
  id          String    @id @default(cuid())
  userId      String
  mode        String    @default("planner")
  goal        String
  status      String    @default("queued")
  currentStep Int       @default(0)
  maxSteps    Int       @default(12)
  summary     String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps     AgentStep[]
  approvals AgentApproval[]
  toolCalls AgentToolCall[]
  decisions AgentDecision[]

  @@index([userId, updatedAt])
  @@index([userId, status])
  @@map("agentrun")
}

model AgentStep {
  id          String    @id @default(cuid())
  runId       String
  stepNumber  Int
  kind        String
  status      String    @default("pending")
  title       String
  detail      String?
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  run       AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  approvals AgentApproval[]
  toolCalls AgentToolCall[]

  @@unique([runId, stepNumber])
  @@index([runId, status])
  @@map("agentstep")
}

model AgentApproval {
  id             String    @id @default(cuid())
  runId          String
  stepId         String?
  action         String
  status         String    @default("pending")
  payload        Json?
  decisionReason String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  run  AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  step AgentStep? @relation(fields: [stepId], references: [id])

  @@index([runId, status])
  @@map("agentapproval")
}

model AgentToolCall {
  id             String    @id @default(cuid())
  runId          String
  stepId         String?
  toolName       String
  status         String    @default("pending")
  idempotencyKey String?   @unique
  input          Json?
  output         Json?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  run  AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  step AgentStep? @relation(fields: [stepId], references: [id])

  @@index([runId, status])
  @@index([runId, toolName])
  @@map("agenttoolcall")
}

model AgentDecision {
  id        String   @id @default(cuid())
  userId    String
  runId     String?
  type      String
  reason    String
  action    Json
  status    String   @default("executed")
  feedback  String?
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  AgentRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([runId])
  @@map("agentdecision")
}

model UserMemory {
  id         String                      @id @default(cuid())
  userId     String
  type       String                      @default("fact")
  content    String
  embedding  Unsupported("jsonb")
  importance Float                       @default(0.5)
  confidence Float                       @default(0.5)
  lastUsed   DateTime?
  createdAt  DateTime                    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, importance])
  @@index([userId, lastUsed])
  @@map("usermemory")
}

model AIHistory {
  id        String   @id @default(cuid())
  userId    String
  message   String
  response  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("aihistory")
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  userId     String
  sourceName String
  sourceType String                      @default("text")
  chunkIndex Int
  content    String
  embedding  Unsupported("jsonb")
  createdAt  DateTime                    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sourceName])
  @@index([sourceName])
  @@map("documentchunk")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("reminder")
  title     String
  content   String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, type])
  @@map("notification")
}

model AgentSchedule {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("daily_review")
  cron      String   @default("0 9 * * *")
  enabled   Boolean  @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([enabled, nextRunAt])
  @@map("agentschedule")
}
