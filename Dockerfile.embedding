# ============================================================
# Python Embedding 服务
# 模型: BAAI/bge-small-zh-v1.5 (24MB, 512维, 中文优化)
# 端口: 8765
# 注意: 云服务器虚拟 CPU 可能不兼容 torch 2.x 的 AVX2 指令，
# 使用 Python 3.10 + torch 1.13.1
# ============================================================
FROM python:3.10-slim

WORKDIR /app

# 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 先装 torch CPU 版
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    --trusted-host download.pytorch.org \
    torch

# 其他依赖用阿里云镜像（版本锁定，兼容 torch 1.13.1）
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/
RUN pip config set global.trusted-host mirrors.aliyun.com
RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    "sentence-transformers==2.2.2" \
    "transformers==4.30.2" \
    "numpy<2" \
    pydantic

# CPU 兼容性环境变量
ENV OPENBLAS_CORETYPE=NEHALEM
ENV MKL_ENABLE_INSTRUCTIONS=SSE4_2

# 模型缓存目录（模型从 volume 挂载，不预下载）
ENV HF_HOME=/app/models
ENV TRANSFORMERS_CACHE=/app/models/transformers

# 复制服务代码
COPY src/lib/rag/embedding_service/server.py ./server.py

EXPOSE 8765

CMD ["python", "server.py"]
